/**
 * Returns the dashboard redirect path for the first role in the roles array.
 */
export const getDashboardRoute = (roles = []) => {
  if (!roles || roles.length === 0) return "/login";
  const role = roles[0];
  return ROLE_DASHBOARD_ROUTES[role] || "/login";
};

