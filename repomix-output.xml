}
.rp-tip-text {
  font-size: 0.85rem;
  color: #4a5060;
  line-height: 1.5;
}

/* ── RIGHT PANEL ── */
.rp-right {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 3rem 2rem;
  background: #0c0e14;
}

.rp-container {
  width: 100%;
  max-width: 420px;
  animation: fadeUp 0.8s 0.2s ease both;
}

/* ── STATES ── */

/* Loading / Validating token */
.rp-loading {
  text-align: center;
  padding: 2rem 0;
}
.rp-loading-spinner {
  width: 36px;
  height: 36px;
  border: 3px solid rgba(200, 169, 110, 0.15);
  border-top-color: #c8a96e;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto 1.5rem;
}
.rp-loading-text {
