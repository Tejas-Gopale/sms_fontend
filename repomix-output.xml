  line-height: 1.65;
  max-width: 300px;
  margin: 0 auto 2rem;
}

/* Success state */
.rp-success {
  text-align: center;
  padding: 1rem 0;
  animation: fadeUp 0.5s ease both;
}
.rp-success-circle {
  width: 80px;
  height: 80px;
  background: linear-gradient(135deg, rgba(200, 169, 110, 0.15), rgba(200, 169, 110, 0.05));
  border: 2px solid rgba(200, 169, 110, 0.35);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 1.75rem;
  font-size: 2rem;
  animation: checkPop 0.6s cubic-bezier(.22, .68, 0, 1.4) 0.1s both,
             ringPulse 1.5s ease 0.7s;
}
.rp-success-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.6rem;
  color: #f0e8d8;
  margin-bottom: 0.75rem;
}
.rp-success-desc {
  font-size: 0.9rem;
  color: #6a7080;
  line-height: 1.65;
  max-width: 300px;
  margin: 0 auto 2rem;
}
.rp-countdown {
  font-size: 0.78rem;
  color: #4a5060;
  margin-top: 1rem;
}
.rp-countdown span {
  color: #c8a96e;
  font-weight: 600;
}

/* ── FORM ── */
.rp-form-header {
  margin-bottom: 2rem;
}
.rp-form-title {
  font-family: 'Playfair Display', serif;
  font-size: 2rem;
  color: #f0e8d8;
  margin-bottom: 0.5rem;
}
.rp-form-subtitle {
  font-size: 0.9rem;
  color: #4a5060;
}

.rp-field {
  margin-bottom: 1.25rem;
}
.rp-field label {
  display: block;
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #6a7080;
  margin-bottom: 0.6rem;
  font-weight: 500;
}
.rp-input-wrap {
  position: relative;
}
.rp-field input {
  width: 100%;
  padding: 0.85rem 3rem 0.85rem 1rem;
  background: #141820;
  border: 1px solid #222632;
  border-radius: 8px;
