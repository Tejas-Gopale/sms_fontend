  letter-spacing: 0.06em;
}

/* Invalid / Expired token */
.rp-invalid {
  text-align: center;
  padding: 1rem 0;
  animation: fadeUp 0.5s ease both;
}
.rp-invalid-icon {
  width: 72px;
  height: 72px;
