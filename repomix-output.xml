<file path="src/super_admin/style/SuperAdminDashboard.css">
/* SuperAdminDashboard.css */
/* Matches the luxury dark-gold theme from LoginPage.css */

@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:ital,wght@0,700;1,700&display=swap');

/* ── KEYFRAMES ── */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes shimmer {
  0%   { background-position: -200% center; }
  100% { background-position:  200% center; }
}
@keyframes pulse-ring {
  0%   { box-shadow: 0 0 0 0 rgba(200, 169, 110, 0.4); }
  70%  { box-shadow: 0 0 0 10px rgba(200, 169, 110, 0); }
  100% { box-shadow: 0 0 0 0 rgba(200, 169, 110, 0); }
}
@keyframes cardIn {
  from { opacity: 0; transform: translateY(16px) scale(0.98); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* ── BASE ── */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* ── LAYOUT ── */
.admin-root {
  display: flex;
  min-height: 100vh;
  background: #0c0e14;
  font-family: 'DM Sans', sans-serif;
  color: #e8dcc8;
}

/* ════════════════════════════════
   SIDEBAR
════════════════════════════════ */
.sidebar {
  width: 240px;
  min-height: 100vh;
  background: linear-gradient(160deg, #0f1117 0%, #141820 100%);
  border-right: 1px solid rgba(200, 169, 110, 0.12);
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 100;
  overflow: hidden;
}

/* decorative glow on sidebar */
.sidebar::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: -40px;
  width: 200px;
  height: 300px;
  background: radial-gradient(ellipse, rgba(200, 169, 110, 0.07) 0%, transparent 70%);
  pointer-events: none;
}

.sidebar-brand {
  padding: 1.75rem 1.5rem 1.5rem;
  border-bottom: 1px solid rgba(200, 169, 110, 0.1);
}

.sidebar-brand-name {
  font-family: 'Playfair Display', serif;
  font-size: 1.3rem;
  color: #f0e8d8;
  letter-spacing: 0.02em;
  display: block;
}

.sidebar-brand-sub {
  font-size: 0.68rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #c8a96e;
  margin-top: 0.2rem;
  display: block;
}

.sidebar-nav {
  flex: 1;
  padding: 1.25rem 0.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.sidebar-link {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.7rem 0.9rem;
  border-radius: 8px;
  font-size: 0.875rem;
  font-weight: 500;
  color: #4a5060;
  text-decoration: none;
  transition: background 0.18s, color 0.18s;
  cursor: pointer;
  border: none;
  background: none;
  font-family: 'DM Sans', sans-serif;
  width: 100%;
  letter-spacing: 0.02em;
}

.sidebar-link:hover {
  background: rgba(200, 169, 110, 0.06);
  color: #c8a96e;
}

.sidebar-link.active {
  background: linear-gradient(90deg, rgba(200, 169, 110, 0.15), rgba(200, 169, 110, 0.05));
  color: #c8a96e;
  border-left: 2px solid #c8a96e;
  padding-left: calc(0.9rem - 2px);
}

.sidebar-link svg {
  flex-shrink: 0;
  opacity: 0.7;
}
.sidebar-link.active svg,
.sidebar-link:hover svg {
  opacity: 1;
}

.sidebar-footer {
  padding: 1rem 0.75rem;
  border-top: 1px solid rgba(200, 169, 110, 0.1);
}

.sidebar-logout {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.7rem 0.9rem;
  border-radius: 8px;
  font-size: 0.875rem;
  font-weight: 500;
  color: #e07070;
  background: none;
  border: none;
  cursor: pointer;
  width: 100%;
  font-family: 'DM Sans', sans-serif;
  transition: background 0.18s;
}

.sidebar-logout:hover {
  background: rgba(220, 60, 60, 0.08);
}

/* ════════════════════════════════
   MAIN CONTENT
════════════════════════════════ */
.admin-main {
  margin-left: 240px;
  flex: 1;
  min-height: 100vh;
  background: #0c0e14;
  padding: 2rem 2.5rem;
  position: relative;
}

/* ambient background glow */
.admin-main::before {
  content: '';
  position: fixed;
  top: 0;
  right: 0;
  width: 500px;
  height: 500px;
  background: radial-gradient(ellipse, rgba(200, 169, 110, 0.04) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

/* ── HEADER ── */
.admin-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2.5rem;
  animation: fadeUp 0.5s ease both;
  position: relative;
  z-index: 1;
}

.admin-header-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.9rem;
  color: #f0e8d8;
  font-weight: 700;
}

.admin-header-sub {
  font-size: 0.8rem;
  color: #4a5060;
  letter-spacing: 0.05em;
  margin-top: 0.2rem;
}

.header-btn {
  padding: 0.7rem 1.4rem;
  background: linear-gradient(135deg, #c8a96e, #a07840);
  border: none;
  border-radius: 8px;
  color: #0c0e14;
  font-size: 0.85rem;
  font-weight: 600;
  font-family: 'DM Sans', sans-serif;
  letter-spacing: 0.06em;
  cursor: pointer;
  transition: opacity 0.2s, transform 0.15s;
}

.header-btn:hover {
  opacity: 0.88;
  transform: translateY(-1px);
}

/* ── STAT CARDS GRID ── */
.cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 1.25rem;
  margin-bottom: 2.5rem;
  position: relative;
  z-index: 1;
}

/* ── INDIVIDUAL STAT CARD ── */
.stat-card {
  background: linear-gradient(145deg, #111420, #0f1117);
  border: 1px solid rgba(200, 169, 110, 0.1);
  border-radius: 14px;
  padding: 1.4rem 1.25rem;
  cursor: pointer;
  text-decoration: none;
  display: block;
  transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  animation: cardIn 0.5s ease both;
  position: relative;
  overflow: hidden;
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  border-radius: 14px 14px 0 0;
  background: var(--card-accent, #c8a96e);
  opacity: 0.5;
  transition: opacity 0.2s;
}

.stat-card:hover {
  border-color: rgba(200, 169, 110, 0.25);
  transform: translateY(-3px);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
}
.stat-card:hover::before {
  opacity: 1;
}

/* stagger animation */
.stat-card:nth-child(1) { animation-delay: 0.05s; }
.stat-card:nth-child(2) { animation-delay: 0.1s;  }
.stat-card:nth-child(3) { animation-delay: 0.15s; }
.stat-card:nth-child(4) { animation-delay: 0.2s;  }
.stat-card:nth-child(5) { animation-delay: 0.25s; }
.stat-card:nth-child(6) { animation-delay: 0.3s;  }

.card-icon-wrap {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 1rem;
  background: rgba(200, 169, 110, 0.08);
  border: 1px solid rgba(200, 169, 110, 0.12);
}

.card-value {
  font-family: 'Playfair Display', serif;
  font-size: 1.8rem;
  color: #f0e8d8;
  font-weight: 700;
  line-height: 1;
  margin-bottom: 0.4rem;
}

.card-title {
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #4a5060;
  font-weight: 500;
}

/* ── ANALYTICS SECTION ── */
.analytics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
  position: relative;
  z-index: 1;
}

.analytics-card {
  background: linear-gradient(145deg, #111420, #0f1117);
  border: 1px solid rgba(200, 169, 110, 0.1);
  border-radius: 14px;
  padding: 1.5rem;
  animation: fadeUp 0.5s 0.35s ease both;
}

.analytics-card.full-width {
  grid-column: 1 / -1;
}

.analytics-card-title {
  font-family: 'Playfair Display', serif;
  font-size: 1rem;
  color: #f0e8d8;
  margin-bottom: 1.25rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.analytics-card-title::after {
  content: '';
  flex: 1;
  height: 1px;
  background: rgba(200, 169, 110, 0.1);
  margin-left: 0.5rem;
}

/* ── SECTION LABEL ── */
.section-eyebrow {
  font-size: 0.68rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #c8a96e;
  margin-bottom: 1rem;
  font-weight: 500;
  animation: fadeUp 0.5s 0.25s ease both;
  position: relative;
  z-index: 1;
}

/* ── ACTIVITY ITEM ── */
.activity-item {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  padding: 0.65rem 0;
  border-bottom: 1px solid rgba(200, 169, 110, 0.06);
}
.activity-item:last-child { border-bottom: none; }

.activity-icon {
  width: 34px;
  height: 34px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(200, 169, 110, 0.07);
  border: 1px solid rgba(200, 169, 110, 0.1);
  flex-shrink: 0;
  color: #c8a96e;
}

.activity-text {
  font-size: 0.875rem;
  color: #c8c4bc;
}
.activity-time {
  font-size: 0.75rem;
  color: #3a4050;
  margin-top: 0.1rem;
}

/* ── EXPIRING TABLE ── */
.expiry-table {
  width: 100%;
  border-collapse: collapse;
}
.expiry-table thead tr {
  border-bottom: 1px solid rgba(200, 169, 110, 0.1);
}
.expiry-table th {
  font-size: 0.68rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #4a5060;
  font-weight: 500;
  padding: 0.5rem 0.75rem;
  text-align: left;
}
.expiry-table td {
  padding: 0.75rem;
  font-size: 0.875rem;
  color: #c8c4bc;
  border-bottom: 1px solid rgba(255,255,255,0.04);
}
.expiry-table tr:last-child td { border-bottom: none; }

.days-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  background: rgba(220, 60, 60, 0.1);
  border: 1px solid rgba(220, 60, 60, 0.2);
  color: #e07070;
  padding: 0.2rem 0.6rem;
  border-radius: 99px;
  font-size: 0.75rem;
  font-weight: 600;
}

/* ── MODAL OVERLAY ── */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  animation: fadeUp 0.2s ease;
}

.modal-box {
  background: linear-gradient(145deg, #111420, #0f1117);
  border: 1px solid rgba(200, 169, 110, 0.15);
  border-radius: 18px;
  width: 90%;
  max-width: 900px;
  max-height: 88vh;
  overflow-y: auto;
  padding: 2rem;
  position: relative;
}

.modal-close {
  position: absolute;
  top: 1.25rem;
  right: 1.25rem;
  background: rgba(200, 169, 110, 0.08);
  border: 1px solid rgba(200, 169, 110, 0.15);
  border-radius: 8px;
  color: #c8a96e;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 1rem;
  transition: background 0.15s;
}
.modal-close:hover {
  background: rgba(220, 60, 60, 0.12);
  color: #e07070;
  border-color: rgba(220, 60, 60, 0.2);
}

/* ── ONBOARDING FORM ── */
.onboard-form-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.6rem;
  color: #f0e8d8;
  margin-bottom: 0.25rem;
}
.onboard-section-title {
  font-size: 0.72rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #c8a96e;
  font-weight: 500;
  margin-bottom: 1rem;
  margin-top: 0.25rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid rgba(200, 169, 110, 0.1);
}
.onboard-section {
  margin-bottom: 2rem;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
}

.form-input {
  width: 100%;
  padding: 0.8rem 1rem;
  background: #0c0e14;
  border: 1px solid #222632;
  border-radius: 8px;
  color: #e8dcc8;
  font-size: 0.9rem;
  font-family: 'DM Sans', sans-serif;
  transition: border-color 0.2s, box-shadow 0.2s;
  outline: none;
}
.form-input:focus {
  border-color: #c8a96e;
  box-shadow: 0 0 0 3px rgba(200, 169, 110, 0.1);
}
.form-input::placeholder { color: #2a3040; }

.form-select {
  width: 100%;
  padding: 0.8rem 1rem;
  background: #0c0e14;
  border: 1px solid #222632;
  border-radius: 8px;
  color: #e8dcc8;
  font-size: 0.9rem;
  font-family: 'DM Sans', sans-serif;
  outline: none;
  cursor: pointer;
  transition: border-color 0.2s;
}
.form-select:focus {
  border-color: #c8a96e;
  box-shadow: 0 0 0 3px rgba(200, 169, 110, 0.1);
}

.form-checkbox-row {
  display: flex;
  gap: 2rem;
  margin-bottom: 1.5rem;
}

.form-checkbox-label {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.875rem;
  color: #7a8090;
  cursor: pointer;
