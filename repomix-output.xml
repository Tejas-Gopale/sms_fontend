  border: 2px solid rgba(220, 60, 60, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 1.5rem;
  font-size: 1.8rem;
  animation: tokenExpiredPulse 2s ease infinite;
}
.rp-invalid-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.6rem;
  color: #f0e8d8;
