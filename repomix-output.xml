  teacherInfoBox: { background: "#F0FDF4", border: "1px solid #BBF7D0", borderRadius: 8, padding: "8px 12px", display: "flex", flexDirection: "column", gap: 2 },
  teacherInfoName: { fontSize: 13, fontWeight: 600, color: "#15803D" },
