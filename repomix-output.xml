// TAB: NOTIFICATIONS
// Backend: GET /user/notification-preferences
//          PUT /user/notification-preferences
// ═════════════════════════════════════════════
function NotificationsTab({ addToast }) {
  const defaultPrefs = {
    emailAttendance: true,  emailLeave: true,  emailExam: true,
    emailSalary: true,      emailNewsletter: false,
    pushAttendance: true,   pushLeave: true,   pushExam: false,   pushSalary: false,
