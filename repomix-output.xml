  });
  const [showPw, setShowPw] = useState({ current: false, new: false, confirm: false });

  // ── Payment state ────────────────────────────────────────────────
  const [payment, setPayment] = useState({
    gatewayName: "RAZORPAY",
    apiKey: "",
    apiSecret: "",
