            </button>
            <div className="modal-title">➕ Add New Class</div>
            <div className="modal-body">
              <div className="field-group">
                <div className="modal-label">Grade</div>
                <input
                  className="modal-input"
                  placeholder="e.g. LKG, Grade 5"
