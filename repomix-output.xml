          </Field>
          <Field label="Timezone">
            <Select value={prefs.timezone} onChange={(v) => set("timezone", v)}
              options={[{ value: "Asia/Kolkata", label: "IST — Kolkata" }, { value: "Asia/Mumbai", label: "IST — Mumbai" }, { value: "UTC", label: "UTC" }]} />
