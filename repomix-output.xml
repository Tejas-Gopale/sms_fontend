        <div className="flex gap-1 bg-white rounded-xl shadow-sm border border-gray-100 p-1 w-fit mb-6">
          {tabs.map(({ key, label, icon: Icon }) => (
            <button
              key={key}
              onClick={() => setActiveTab(key)}
