  RefreshCw, Loader2, CheckCircle2, XCircle, Pin, PinOff, Trash2,
  UserCheck, Mail, Phone, Building2, MapPin, Linkedin, Award,
  BookOpen, Briefcase, AlertCircle, Eye, Check,
} from "lucide-react";

// ─── Constants ────────────────────────────────────────────────────────────────

const EMPLOYMENT_STATUS = [
