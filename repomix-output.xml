.rp-strength-label.fair   { color: #e0a030; }
.rp-strength-label.good   { color: #60b060; }
.rp-strength-label.strong { color: #c8a96e; }

/* Match indicator */
.rp-match {
  margin-top: 0.4rem;
  font-size: 0.75rem;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}
.rp-match.match-ok  { color: #71d38e; }
.rp-match.match-err { color: #e07070; }

/* ── ALERTS ── */
.rp-error-box {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  background: rgba(220, 60, 60, 0.08);
  border: 1px solid rgba(220, 60, 60, 0.25);
  border-radius: 8px;
  padding: 0.75rem 1rem;
  margin-bottom: 1.25rem;
  font-size: 0.875rem;
  color: #e07070;
  animation: fadeUp 0.3s ease;
}

/* ── SUBMIT BUTTON ── */
.rp-submit-btn {
  width: 100%;
  padding: 0.95rem;
  background: linear-gradient(135deg, #c8a96e, #a07840);
  border: none;
  border-radius: 8px;
  color: #0c0e14;
  font-size: 0.9rem;
  font-weight: 600;
  font-family: 'DM Sans', sans-serif;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  cursor: pointer;
  transition: opacity 0.2s, transform 0.15s;
  margin-top: 0.5rem;
}
.rp-submit-btn:hover:not(:disabled) {
  opacity: 0.9;
  transform: translateY(-1px);
}
.rp-submit-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.rp-outline-btn {
  width: 100%;
  padding: 0.85rem;
  background: transparent;
  border: 1px solid rgba(200, 169, 110, 0.25);
  border-radius: 8px;
  color: #c8a96e;
  font-size: 0.85rem;
  font-weight: 500;
  font-family: 'DM Sans', sans-serif;
  letter-spacing: 0.06em;
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s, transform 0.15s;
  margin-top: 0.75rem;
  display: flex;
  align-items: center;
