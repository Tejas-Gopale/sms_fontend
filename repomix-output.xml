        <Toggle checked={prefs.emailLeave}        onChange={() => toggle("emailLeave")}        label="Leave Request Updates"    sub="Status changes on your leave applications" />
        <Toggle checked={prefs.emailExam}         onChange={() => toggle("emailExam")}         label="Exam & Test Reminders"    sub="Upcoming exams and result uploads" />
        <Toggle checked={prefs.emailSalary}       onChange={() => toggle("emailSalary")}       label="Salary Disbursement"      sub="Notified when salary is credited" />
        <Toggle checked={prefs.emailNewsletter}   onChange={() => toggle("emailNewsletter")}   label="School Newsletter"        sub="Monthly newsletter and announcements" />
      </Section>
      <Section icon={Bell} title="Push Notifications" subtitle="Browser and mobile push alerts" accent="violet">
        <Toggle checked={prefs.pushAttendance} onChange={() => toggle("pushAttendance")} label="Attendance"   sub="Real-time alerts for attendance events" />
        <Toggle checked={prefs.pushLeave}      onChange={() => toggle("pushLeave")}      label="Leave Updates" sub="Instant notification on leave status" />
        <Toggle checked={prefs.pushExam}       onChange={() => toggle("pushExam")}       label="Exams & Tests" sub="Reminders before exam dates" />
