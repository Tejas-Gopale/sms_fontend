        { name: "School Owner", icon: "UserCircle",      path: "/super-admin/school-owner" },
        { name: "Students",     icon: "Users",           path: "/super-admin/students" },
        { name: "Teachers",     icon: "GraduationCap",   path: "/super-admin/teachers" },
