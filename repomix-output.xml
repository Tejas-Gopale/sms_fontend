        <div className="space-y-4">
          <Field label="Theme">
            <div className="flex gap-3">
              {[{ value: "light", label: "Light", icon: Sun }, { value: "dark", label: "Dark", icon: Moon }, { value: "auto", label: "System", icon: Monitor }]
